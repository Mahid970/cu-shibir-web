# Copy to .env and fill in. See README → "Environment".
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/cushibir
# 64+ random hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local seed admin for development (npm run seed:admin)
SEED_ADMIN_EMAIL=admin@cushibir.local
SEED_ADMIN_PASSWORD=

# Cache purge endpoint for scripts (POST /next/revalidate)
REVALIDATE_SECRET=
