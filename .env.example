# Copy to .env (development) or .env.production (docker compose) and fill in.
# Generate secrets with:  openssl rand -hex 32

# ---- Database -------------------------------------------------------------------
# Development: the embedded Postgres started by `npm run db`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/cushibir
# Production (docker-compose.yml builds DATABASE_URL from these):
POSTGRES_DB=cushibir
POSTGRES_USER=cushibir
POSTGRES_PASSWORD=
# Local production builds against the dev database: skip migrations (schema is pushed in dev).
# PAYLOAD_MIGRATE_ON_START=false

# ---- App ------------------------------------------------------------------------
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cache purge endpoint for scripts (POST /next/revalidate)
REVALIDATE_SECRET=

# ---- Personal data --------------------------------------------------------------
# 32 bytes (64 hex chars). Encrypts names, phone numbers and messages from the public forms.
# Keep a copy somewhere safe: without it the stored submissions cannot be read.
FIELD_ENCRYPTION_KEY=

# ---- Optional -------------------------------------------------------------------
# Cloudflare Turnstile on the public forms (both keys, or neither)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Telegram notice to the branch's private group when a form arrives (no personal data is sent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# System Chromium for share cards (the Docker image sets this)
# CHROMIUM_PATH=/usr/bin/chromium
# Stop the in-process job runner (extra replicas)
# PAYLOAD_DISABLE_JOBS=true
# Keep a staging site out of search engines
# SITE_NOINDEX=true

# ---- Development only -----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cushibir.local
SEED_ADMIN_PASSWORD=
